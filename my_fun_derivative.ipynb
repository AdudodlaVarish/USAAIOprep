   "source": [
    "import numpy as np\n",
    "\n",
    "def my_fun_derivative(X, y, theta):\n",
    "\n",
    "    N, d = X.shape\n",
    "    predictions = np.sum(theta * X, axis = -1)\n",
    "    errors= y - predictions\n",
    "    return (-2 / N) * np.sum(X * errors[:, None], axis = 0)\n",
    "    "
